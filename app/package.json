{
  "name": "@blackskies/app",
  "private": true,
  "version": "1.0.0-rc1",
  "description": "Electron desktop client for the Black Skies writing toolkit.",
  "author": "Black Skies",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:renderer": "vite build",
    "build:main": "tsc --project tsconfig.main.json && node ./scripts/write-dist-commonjs.cjs",
    "build:production": "vite build && tsc --project tsconfig.main.json && node ./scripts/write-dist-commonjs.cjs",
    "preview": "vite preview",
    "lint": "node ../scripts/run-app-eslint.mjs",
    "typecheck:all": "tsc --noEmit --project tsconfig.json",
    "test": "node ../scripts/run-vitest-offline.mjs",
    "qualification:import-scores": "pnpm run build:main && node dist-electron/main/aiCritiqueScoreImportCli.js",
    "package:verify:preflight": "node ./scripts/stage19-package-verify.mjs --preflight",
    "package:verify:unpacked": "node ./scripts/stage19-package-verify.mjs --preflight --unpacked ./release/win-unpacked",
    "package:verify:installer": "node ./scripts/stage19-package-verify.mjs --preflight --unpacked ./release/win-unpacked --installer ./release/BlackSkies-Setup-1.0.0-rc1.exe --receipt ./release/stage19-package-receipt.json",
    "package:smoke:installed": "node ./scripts/stage19-installed-smoke.mjs",
    "package:dir": "node ./scripts/stage19-package-verify.mjs --preflight && vite build && tsc --project tsconfig.main.json && node ./scripts/write-dist-commonjs.cjs && electron-builder --config electron-builder.yml --dir && node ./scripts/stage19-package-verify.mjs --preflight --unpacked ./release/win-unpacked",
    "package:win": "node ./scripts/stage19-package-verify.mjs --preflight && vite build && tsc --project tsconfig.main.json && node ./scripts/write-dist-commonjs.cjs && electron-builder --config electron-builder.yml --win nsis --publish never && node ./scripts/stage19-package-verify.mjs --preflight --unpacked ./release/win-unpacked --installer ./release/BlackSkies-Setup-1.0.0-rc1.exe --receipt ./release/stage19-package-receipt.json",
    "e2e:build": "pnpm run build:production",
    "e2e:test": "pnpm exec playwright test --project=electron --workers=1 --reporter=list --trace=on",
    "e2e:last": "pnpm exec playwright test --last-failed --project=electron --workers=1 --reporter=list --trace=on",
    "e2e": "playwright test -c ./playwright.config.ts",
    "e2e:headed": "playwright test -c ./playwright.config.ts --headed",
    "e2e:report": "playwright show-report",
    "test:e2e": "pnpm run build:renderer && pnpm run build:main && pnpm exec playwright test"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.2.4",
    "@codemirror/language": "^6.10.2",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-mosaic-component": "^6.2.0",
    "react-resizable": "^3.0.5",
    "react-rnd": "^10.4.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/react-resizable": "^3.0.8",
    "@types/react-rnd": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "electron": "^39.8.9",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^6.1.1",
    "jsdom": "^24.0.0",
    "playwright": "^1.56.1",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vite": "^8.2.0",
    "vitest": "^4.1.5"
  }
}
