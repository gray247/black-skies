{
    "name": "black-skies",
    "private": true,
    "version": "1.0.0-rc1",
    "type": "module",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=8.0.0"
    },
    "scripts": {
        "bootstrap": "pnpm install --recursive --frozen-lockfile",
        "python:check": "python ./scripts/require_python311.py",
        "lint": "pnpm -r lint",
        "typecheck:all": "pnpm --filter @blackskies/app typecheck:all",
        "dev": "node ./scripts/dev-runner.mjs",
        "lint:docs": "node ./scripts/check-current-authority-docs.mjs",
        "test:e2e": "node ./scripts/e2e-with-backend.mjs",
        "test:e2e:args": "node ./scripts/test_e2e_launcher_args.mjs",
        "test:truth": "node ./scripts/truth-with-backend.mjs",
        "test:service-truth": "python ./scripts/run_service_truth.py",
        "verify:gauntlet": "python ./scripts/verify_gauntlet.py",
        "repo:hygiene": "python scripts/check_repo_hygiene.py --tracked",
        "foundation:inventory": "node scripts/verify-foundation-inventory.mjs",
        "foundation:coverage": "python scripts/run_foundation_supported_core_coverage.py",
        "foundation:performance": "node scripts/verify-foundation-performance-budget.mjs",
        "program3:performance": "node scripts/verify-program3-combined-performance.mjs",
        "stage19:lint": "node ./scripts/run-stage19-eslint.mjs",
        "stage19:regression": "node ./scripts/stage19-regression.mjs"
    },
    "devDependencies": {
        "markdownlint-cli": "^0.48.0"
    },
    "packageManager": "pnpm@8.15.9+sha512.499434c9d8fdd1a2794ebf4552b3b25c0a633abcee5bb15e7b5de90f32f47b513aca98cd5cfd001c31f0db454bc3804edccd578501e4ca293a6816166bbd9f81",
    "dependencies": {
        "ws": "^8.21.2",
        "yaml": "^2.8.3"
    },
    "pnpm": {
        "patchedDependencies": {
            "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch"
        },
        "overrides": {
            "minimatch@>=3.0.0 <4.0.0": "3.1.4",
            "flatted@>=3.0.0 <4.0.0": "3.4.2",
            "tmp@>=0.2.0 <0.3.0": "0.2.7",
            "form-data@>=4.0.0 <5.0.0": "4.0.6",
            "undici@>=6.0.0 <7.0.0": "6.28.0",
            "linkify-it@>=5.0.0 <6.0.0": "5.0.2",
            "ws@>=8.0.0 <9.0.0": "8.21.2",
            "brace-expansion@>=1.0.0 <2.0.0": "1.1.18",
            "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
            "brace-expansion@>=5.0.0 <6.0.0": "5.0.9",
            "js-yaml@>=4.0.0 <6.0.0": "5.2.3",
            "tar@>=7.0.0 <8.0.0": "7.5.22",
            "builder-util-runtime@>=9.0.0 <10.0.0": "9.7.0",
            "postcss@>=8.0.0 <9.0.0": "8.5.25",
            "uuid@>=9.0.0 <11.1.1": "11.1.1",
            "markdown-it@>=14.0.0 <14.2.0": "14.2.0"
        }
    }
}
