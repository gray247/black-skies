# Black Skies services configuration example
#
# Copy this file to `.env` and adjust the values for your machine. The
# FastAPI services load keys with the `BLACKSKIES_` prefix via
# `ServiceSettings.from_environment`, and agent-mode toggles rely on the
# `BLACK_SKIES_` prefix (`services/settings.py`).
#
# RC1 ships in offline mode with a dummy provider key. Leave this value in
# place unless you intend to wire up a live provider.
OPENAI_API_KEY=dummy
BLACKSKIES_OPENAI_API_KEY=dummy

# Core content directory for outlines, drafts, critiques, etc.
# Replace with the absolute path to your project root when packaging or
# running smoke tests outside the repository.
BLACKSKIES_PROJECT_BASE_DIR=./sample_project

# Maximum allowed HTTP request payload size in bytes.
BLACKSKIES_MAX_REQUEST_BODY_BYTES=524288

# Agent runtime mode (offline keeps everything local).
BLACK_SKIES_BLACK_SKIES_MODE=offline

# Optional overrides set during packaging or QA to raise/lower spend
# ceilings. Defaults align with the RC1 policy ($5 soft, $10 hard).
BLACKSKIES_SOFT_BUDGET_LIMIT_USD=5.00
BLACKSKIES_HARD_BUDGET_LIMIT_USD=10.00

# Optional plugin registry filters (comma-separated identifiers). Leave
# empty for the default RC1 surface, or specify plugin IDs to opt-in/out.
BLACKSKIES_PLUGIN_ALLOW_LIST=
BLACKSKIES_PLUGIN_DENY_LIST=

# Task timeout and retry guards for generation pipelines.
BLACKSKIES_DRAFT_TASK_TIMEOUT_SECONDS=120
BLACKSKIES_DRAFT_TASK_RETRY_ATTEMPTS=1
BLACKSKIES_CRITIQUE_TASK_TIMEOUT_SECONDS=90
BLACKSKIES_CRITIQUE_TASK_RETRY_ATTEMPTS=1
BLACKSKIES_CRITIQUE_CIRCUIT_FAILURE_THRESHOLD=3
BLACKSKIES_CRITIQUE_CIRCUIT_RESET_SECONDS=45
BLACKSKIES_ANALYTICS_TASK_TIMEOUT_SECONDS=60
BLACKSKIES_ANALYTICS_TASK_RETRY_ATTEMPTS=1
BLACKSKIES_ANALYTICS_CIRCUIT_FAILURE_THRESHOLD=3
BLACKSKIES_ANALYTICS_CIRCUIT_RESET_SECONDS=60
BLACKSKIES_MODEL_ROUTING_POLICY=local_only
BLACKSKIES_MODEL_ROUTER_LOG_DECISIONS=true
BLACKSKIES_MODEL_ROUTER_METADATA_ENABLED=false
BLACKSKIES_MODEL_ROUTER_PROVIDER_CALLS_ENABLED=false
BLACKSKIES_LONG_FORM_PROVIDER_ENABLED=false
BLACKSKIES_LOCAL_PROVIDER=ollama
BLACKSKIES_LOCAL_MODEL=qwen3:4b
BLACKSKIES_LOCAL_TIMEOUT_SECONDS=12
BLACKSKIES_LOCAL_LLM_AVAILABLE=true
BLACKSKIES_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
BLACKSKIES_LOCAL_LLM_MODEL=qwen3:4b
BLACKSKIES_LOCAL_LLM_HEALTH_CHECK=false
BLACKSKIES_LOCAL_LLM_TIMEOUT_SECONDS=12
BLACKSKIES_OPENAI_MODEL=gpt-4o-mini
BLACKSKIES_OPENAI_BASE_URL=https://api.openai.com/v1
BLACKSKIES_OPENAI_HEALTH_CHECK=false
BLACKSKIES_OPENAI_TIMEOUT_SECONDS=30

# Backup verification daemon controls.
BLACKSKIES_BACKUP_VERIFIER_ENABLED=false
BLACKSKIES_BACKUP_VERIFIER_INTERVAL_SECONDS=1800
BLACKSKIES_BACKUP_VERIFIER_BACKOFF_MAX_SECONDS=14400
# Interval for the scheduled snapshot verifier runs.
BLACKSKIES_VERIFIER_SCHEDULE_SECONDS=3600

# Memory Lab advisory controls.
BLACKSKIES_MEMORY_LAB_ENABLED=false
BLACKSKIES_MEMORY_LAB_RUNTIME_PROFILE=stable_default
BLACKSKIES_MEMORY_LAB_MAX_CANDIDATES=8
BLACKSKIES_MEMORY_LAB_MAX_UNRESOLVED=5
BLACKSKIES_MEMORY_LAB_WRITE_LEGACY_CONTINUITY=true
BLACKSKIES_MEMORY_LAB_DEBUG_LOGGING=false
BLACKSKIES_MEMORY_LAB_ANCHOR_ENABLED=false
BLACKSKIES_MEMORY_LAB_ANCHOR_AUTO_THRESHOLD=3
BLACKSKIES_MEMORY_LAB_REINFORCEMENT_ENABLED=false
BLACKSKIES_MEMORY_LAB_INTERPRETATIONS_ENABLED=false
BLACKSKIES_MEMORY_LAB_MAX_INTERPRETATIONS_PER_GROUP=2
BLACKSKIES_MEMORY_LAB_ALTERNATE_INTERPRETATION_THRESHOLD=0.08
BLACKSKIES_MEMORY_LAB_WEIGHT_MAX=2.0
BLACKSKIES_MEMORY_LAB_DECAY_ENABLED=false
BLACKSKIES_MEMORY_LAB_DECAY_BASE_RATE=0.03
BLACKSKIES_MEMORY_LAB_DECAY_MIN_WEIGHT=0.05
BLACKSKIES_MEMORY_LAB_DECAY_FADING_THRESHOLD=0.40
BLACKSKIES_MEMORY_LAB_DECAY_SUPPRESSED_THRESHOLD=0.20
BLACKSKIES_MEMORY_LAB_DECAY_ARCHIVED_THRESHOLD=0.10
BLACKSKIES_MEMORY_LAB_DECAY_LOG_ANCHOR_PROTECTION=false
BLACKSKIES_MEMORY_LAB_DECAY_ALLOW_REVIVAL=true
BLACKSKIES_MEMORY_LAB_DECAY_SUPPRESSED_FALLBACK_ENABLED=true
BLACKSKIES_MEMORY_LAB_DECAY_LOW_CONFIDENCE_FALLBACK_THRESHOLD=0.35
BLACKSKIES_MEMORY_LAB_REINFORCEMENT_EVENT_RETENTION_LIMIT=200
BLACKSKIES_MEMORY_LAB_DECAY_EVENT_RETENTION_LIMIT=200
BLACKSKIES_MEMORY_LAB_CONTESTED_EVENT_RETENTION_LIMIT=200
BLACKSKIES_MEMORY_LAB_DIAGNOSTICS_LEVEL=standard
BLACKSKIES_MEMORY_LAB_EXPERIMENTAL_ENABLED=false
BLACKSKIES_MEMORY_LAB_EXPERIMENTAL_ACTIVE_EXPERIMENTS=
BLACKSKIES_MEMORY_LAB_EXPERIMENTAL_FAIL_CLOSED=true
BLACKSKIES_MEMORY_LAB_EXPERIMENTAL_LOG_EVENTS=true
