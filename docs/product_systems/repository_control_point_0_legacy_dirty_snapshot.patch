+  it("rejects incomplete lifecycle and altered external preservation evidence", () => {
+    const lifecycle = {
+      qualifiedCommit: commit,
+      installedOffline: true,
+      representativeWorkloadPassed: true,
+      forbiddenRuntimeProcessCount: 0,
+      uninstallRemovedApplication: true,
