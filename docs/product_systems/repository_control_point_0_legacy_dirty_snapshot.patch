+
+const commit = "a".repeat(40);
+const installer = {
+  filename: "BlackSkies-Setup-1.0.0-rc1.exe",
+  byteLength: 100,
+  sha256: "b".repeat(64)
+};
+const receipt = {
+  schema: "black-skies.stage19.package-receipt.v1",
+  qualifiedCommit: commit,
+  protectedEvidenceUsed: false,
+  signatureStatus: "NotSigned",
+  installer: { ...installer, signatureStatus: "NotSigned" },
+  unpacked: {
+    executable: { sha256: "c".repeat(64) },
+    asar: { sha256: "d".repeat(64) }
