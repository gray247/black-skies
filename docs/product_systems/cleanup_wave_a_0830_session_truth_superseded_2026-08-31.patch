@@ -0,0 +1,98 @@
+export type TruthDomain = 'runtime-truth' | 'project-truth';
+
+export type TruthOwner = 'main-process' | 'renderer' | 'backend-service' | 'project-files';
+
+export interface TruthOwnershipBoundary {
+  readonly owner: TruthOwner;
+  readonly domain: TruthDomain;
+  readonly authority: 'authoritative' | 'derived';
+  readonly persistence: 'volatile' | 'persisted';
+}
+
+export const TRUTH_OWNERSHIP_BOUNDARIES: Readonly<Record<TruthOwner, TruthOwnershipBoundary>> =
+  Object.freeze({
+    'main-process': Object.freeze({
+      owner: 'main-process',
+      domain: 'runtime-truth',
+      authority: 'authoritative',
+      persistence: 'volatile',
+    }),
+    renderer: Object.freeze({
+      owner: 'renderer',
+      domain: 'runtime-truth',
+      authority: 'derived',
+      persistence: 'volatile',
+    }),
+    'backend-service': Object.freeze({
+      owner: 'backend-service',
+      domain: 'runtime-truth',
+      authority: 'authoritative',
+      persistence: 'volatile',
+    }),
+    'project-files': Object.freeze({
+      owner: 'project-files',
+      domain: 'project-truth',
+      authority: 'authoritative',
+      persistence: 'persisted',
+    }),
+  });
+
+export type SessionLifecycleState =
+  | 'runtime-only'
+  | 'persisted'
+  | 'dirty'
+  | 'unsaved'
+  | 'stale'
+  | 'partial'
+  | 'recovery-required';
+
+export interface SessionLifecycleSignals {
+  readonly projectFilesPresent?: boolean;
+  readonly dirty?: boolean;
+  readonly unsaved?: boolean;
+  readonly stale?: boolean;
+  readonly partial?: boolean;
+  readonly recoveryRequired?: boolean;
+}
+
+export const SESSION_LIFECYCLE_PRIORITY = Object.freeze([
+  'recovery-required',
+  'partial',
+  'stale',
+  'unsaved',
+  'dirty',
+  'persisted',
+  'runtime-only',
+] as const satisfies readonly SessionLifecycleState[]);
+
+export function classifySessionLifecycleState(
+  signals: SessionLifecycleSignals,
+): SessionLifecycleState {
+  if (signals.recoveryRequired) {
+    return 'recovery-required';
+  }
+  if (signals.partial) {
+    return 'partial';
+  }
+  if (signals.stale) {
+    return 'stale';
+  }
+  if (signals.unsaved) {
+    return 'unsaved';
+  }
+  if (signals.dirty) {
+    return 'dirty';
+  }
+  if (signals.projectFilesPresent) {
+    return 'persisted';
+  }
+  return 'runtime-only';
+}
+
+export function isRuntimeTruthState(state: SessionLifecycleState): boolean {
+  return state === 'runtime-only' || state === 'dirty' || state === 'unsaved';
+}
+
+export function isProjectTruthState(state: SessionLifecycleState): boolean {
+  return !isRuntimeTruthState(state);
+}
