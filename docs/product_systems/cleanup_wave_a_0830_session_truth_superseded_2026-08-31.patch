+import { describe, expect, it } from 'vitest';
+
+import {
+  classifySessionLifecycleState,
+  isProjectTruthState,
+  isRuntimeTruthState,
+  SESSION_LIFECYCLE_PRIORITY,
+  TRUTH_OWNERSHIP_BOUNDARIES,
+} from '../../shared/sessionTruth';
+
+describe('sessionTruth', () => {
+  it('defines explicit ownership boundaries for runtime and project truth', () => {
+    expect(TRUTH_OWNERSHIP_BOUNDARIES).toMatchObject({
+      'main-process': {
+        owner: 'main-process',
+        domain: 'runtime-truth',
+        authority: 'authoritative',
+        persistence: 'volatile',
+      },
+      renderer: {
+        owner: 'renderer',
+        domain: 'runtime-truth',
+        authority: 'derived',
+        persistence: 'volatile',
+      },
+      'backend-service': {
+        owner: 'backend-service',
+        domain: 'runtime-truth',
+        authority: 'authoritative',
+        persistence: 'volatile',
+      },
+      'project-files': {
+        owner: 'project-files',
+        domain: 'project-truth',
+        authority: 'authoritative',
+        persistence: 'persisted',
+      },
+    });
+  });
+
+  it('classifies recovery and partial states ahead of weaker lifecycle states', () => {
+    expect(classifySessionLifecycleState({ recoveryRequired: true, projectFilesPresent: true })).toBe(
+      'recovery-required',
+    );
+    expect(classifySessionLifecycleState({ partial: true, projectFilesPresent: true })).toBe('partial');
+    expect(classifySessionLifecycleState({ stale: true, dirty: true, projectFilesPresent: true })).toBe(
+      'stale',
+    );
+  });
+
+  it('keeps dirty, unsaved, persisted, and runtime-only states distinct', () => {
+    expect(classifySessionLifecycleState({ unsaved: true, dirty: true, projectFilesPresent: true })).toBe(
+      'unsaved',
+    );
+    expect(classifySessionLifecycleState({ dirty: true, projectFilesPresent: true })).toBe('dirty');
+    expect(classifySessionLifecycleState({ projectFilesPresent: true })).toBe('persisted');
+    expect(classifySessionLifecycleState({})).toBe('runtime-only');
+  });
+
+  it('exposes the priority order for the lifecycle contract', () => {
+    expect(SESSION_LIFECYCLE_PRIORITY).toEqual([
+      'recovery-required',
+      'partial',
+      'stale',
+      'unsaved',
+      'dirty',
+      'persisted',
+      'runtime-only',
+    ]);
+  });
+
+  it('separates runtime truth states from project truth states', () => {
+    expect(isRuntimeTruthState('runtime-only')).toBe(true);
+    expect(isRuntimeTruthState('dirty')).toBe(true);
+    expect(isRuntimeTruthState('unsaved')).toBe(true);
+    expect(isRuntimeTruthState('persisted')).toBe(false);
+    expect(isProjectTruthState('persisted')).toBe(true);
+    expect(isProjectTruthState('stale')).toBe(true);
+    expect(isProjectTruthState('recovery-required')).toBe(true);
+  });
+});
