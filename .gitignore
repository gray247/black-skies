# =========================
# BLACK SKIES - .gitignore
# =========================

# -------------------------
# Codex / Local Operator State
# -------------------------
.codex
.codex*
.codex_history
.codex_step

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
!build/
build/*
!build/runtime_truth.json
!build/runtime_truth.schema.json
.venv/
venv/
env/
codex_temp/

# -------------------------
# Node / JS (if used anywhere)
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.hypothesis/
app/dist-electron/
app/release/
dist-electron/
app/test-results/
app/playwright-report/
test-results/
playwright-artifacts/
workflow results/
workflow-results/
vendor/wheels/
sample_project/
sample_project/**/.snapshots/
_external_archives/

# -------------------------
# Temp / Scratch Files
# -------------------------
tmp_*
temp_*
*.tmp
*.zip
tmp/
temp/

# -------------------------
# Runtime Artifacts / Generated Data
# -------------------------
.pytest_cache/
.pytest-cache-local/
.pytest-tmp/
pytest-cache-files-*/
**/pytest-cache-files-*/
tmp/pytest/
tmp/pytest-of-*/
**/tmp/pytest/
**/tmp/pytest-of-*/
tmp_budget/
tmp_contract/
tmp_flow/
.tmp/
services/services/pytest-cache-files-*/
services/testtmp-*/
services/.tmp/
services/tmp/
*_restored_*
# -------------------------
# Policy / Runtime Execution Folders
# -------------------------
draft-policy-*/
long-form-policy-*/
long-form-timeout-*/

# -------------------------
# Logs / Runtime Output
# -------------------------
*.log
*.pid
*.jsonl

# Black Skies runtime analytics
**/.blackskies/analytics/runtime.jsonl

# -------------------------
# OS Junk
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# IDE / Editor
# -------------------------
.vscode/
.idea/
*.swp
*.swo

# -------------------------
# Runtime Artifacts / Generated Data
# -------------------------
# pytest caches / temp dirs created by test runs
.pytest_cache/
pytest-cache-files-*/
**/pytest-cache-files-*/

# pytest temp trees
tmp/pytest/
tmp/pytest-of-*/
**/tmp/pytest/
**/tmp/pytest-of-*/

# -------------------------
# Archives / Backups
# -------------------------
*.bak
*.bak*
*.bak2
*.bak3
*.backup
*.old

# -------------------------
# Binary / Generated Media
# -------------------------
*.png
*.jpg
*.jpeg
*.gif

# -------------------------
# KEEP THESE (DO NOT IGNORE)
# -------------------------
!services/src/blackskies/services/py.typed
!docs/
!app/tests/e2e/*.spec.ts-snapshots/
!app/tests/e2e/*.spec.ts-snapshots/*.png

# Local Playwright artifacts
playwright-artifacts*/
app/test-results/
app/playwright-report/
